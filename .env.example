# Copy the values from your own Supabase and Stripe dashboards into
# Vercel's Environment Variables — never into this file or into git.
# See README.md "What I need from you" for exactly where each one comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API -> service_role). Only the Stripe
# webhook uses this — it's the one server code path with no signed-in user to
# check RLS against, so it needs to bypass RLS instead. Keep this out of
# anything that runs in the browser; it's server-only by design.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — powers the automated safety-review pass on new listings
# (lib/safety-review.ts). Without it, every submission just stays
# pending_review for a human, same as before this existed.
ANTHROPIC_API_KEY=
