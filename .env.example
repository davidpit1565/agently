# Copy the values from your own Supabase and Stripe dashboards into
# Vercel's Environment Variables — never into this file or into git.
# See README.md "What I need from you" for exactly where each one comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API -> service_role). Bypasses RLS —
# used by the Stripe webhook (no signed-in user to check RLS against) and
# the agent-request admin routes (no "platform owner" concept RLS can
# express). Keep this out of anything that runs in the browser; it's
# server-only by design.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — powers the automated safety-review pass on new listings
# (lib/safety-review.ts). Without it, every submission just stays
# pending_review for a human, same as before this existed.
ANTHROPIC_API_KEY=

# Your own sign-in email (must exactly match what you sign in with). Gates
# /dashboard/admin/requests — the queue for custom agent requests from
# Professional members. No one else can reach that page even signed in.
PLATFORM_OWNER_EMAIL=
